{
  "OpenPLC Runtime v3": {
    "compiler": "openplc-compiler",
    "preview": "generic.png",
    "cxx_flags": [
      "-std=gnu++17"
    ],
    "capabilities": {
      "pinMapping": false,
      "vppIo": false,
      "modbusTcpRemote": false,
      "ethercat": false,
      "modbusTcpServer": false,
      "opcuaServer": false,
      "s7Server": false,
      "debuggerTransports": [
        "modbus-tcp"
      ],
      "pythonFunctionBlocks": true,
      "arduinoApiCompletions": false,
      "hasRuntimeStats": false,
      "isInProcessSimulator": false,
      "directUsbUpload": false
    },
    "debug": {
      "preconditions": [
        "runtimeConnected"
      ],
      "channels": [
        {
          "label": "Modbus TCP",
          "channel": "tcp",
          "enabledWhen": true,
          "params": {
            "ipAddress": {
              "$ref": "configuration.runtimeIpAddress",
              "required": "Runtime IP address is not configured."
            }
          }
        }
      ]
    }
  }
}
